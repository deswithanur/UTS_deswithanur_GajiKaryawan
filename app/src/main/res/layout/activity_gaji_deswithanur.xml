<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="GAJI KARYAWAN"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nomor Induk Karyawan"
            android:inputType="text" />

        <EditText
            android:id="@+id/etNama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama Karyawan"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etGajiPokok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gaji Pokok"
            android:inputType="number" />

        <EditText
            android:id="@+id/etTunjJabatan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tunjangan Jabatan"
            android:inputType="number" />

        <EditText
            android:id="@+id/etHariKerja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jumlah Hari Kerja"
            android:inputType="number" />

        <Button
            android:id="@+id/btnHitung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#0070C0"
            android:text="HITUNG"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/etTunjMakan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:hint="Tunjangan Makan" />

        <EditText
            android:id="@+id/etTunjTransport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:hint="Tunjangan Transportasi" />

        <EditText
            android:id="@+id/etGajiKotor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:hint="Gaji Kotor" />

        <EditText
            android:id="@+id/etGajiBersih"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:hint="Gaji Bersih" />
    </LinearLayout>
</ScrollView>

